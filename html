     FILE: index.html
     ========================================== -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>PokePlap Enterprise Engine Management Console</title>
    <style>
        :root { --bg-dark: #070b14; --panel-bg: #111a2e; --accent-blue: #2563eb; --accent-green: #059669; --accent-red: #dc2626; --border: #1e293b; --text: #f8fafc; }
        body { font-family: system-ui, sans-serif; background: var(--bg-dark); color: var(--text); padding: 25px; margin: 0; }
        .wrapper { max-width: 1300px; margin: 0 auto; }
        header { border-bottom: 1px solid var(--border); padding-bottom: 20px; margin-bottom: 25px; display: flex; justify-content: space-between; align-items: center; }
        .grid { display: grid; grid-template-columns: 2fr 1fr; gap: 25px; }
        .panel { background: var(--panel-bg); border: 1px solid var(--border); border-radius: 8px; padding: 20px; }
        .panel-header { font-size: 14px; text-transform: uppercase; color: #94a3b8; font-weight: bold; margin-bottom: 15px; letter-spacing: 1px; }
        .vitals-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; margin-bottom: 25px; }
        .card { background: rgba(0,0,0,0.2); border: 1px solid var(--border); padding: 15px; border-radius: 6px; text-align: center; }
        .card-val { font-size: 32px; font-weight: bold; color: var(--accent-green); margin: 5px 0; }
        .card-lbl { font-size: 11px; color: #94a3b8; text-transform: uppercase; }
        .control-group { margin-bottom: 15px; }
        label { display: block; font-size: 12px; margin-bottom: 6px; color: #94a3b8; }
        select, input, button { width: 100%; padding: 12px; background: var(--bg-dark); border: 1px solid var(--border); color: white; border-radius: 6px; box-sizing: border-box; font-weight: 600; }
        button { cursor: pointer; background: var(--accent-blue); border: none; transition: filter 0.2s; }
        button:hover { filter: brightness(1.2); }
        .footer-bar { margin-top: 25px; background: var(--panel-bg); border: 1px solid var(--border); padding: 15px; border-radius: 8px; display: flex; align-items: center; gap: 20px; font-family: monospace; }
    </style>
</head>
<body>
<div class="wrapper">
    <header>
        <div>
            <h1 style="margin:0; font-size:26px;">PokePlap Enterprise Core Matrix</h1>
            <small style="color:#64748b;">Cross-Sector Predictive Time-Scrubbing Interface Loop</small>
        </div>
        <div style="width: 250px;">
            <label>TARGET SECTOR INTERFACE DEPLOYMENT</label>
            <select id="sector-selector" onchange="switchSector()">
                <option value="icu_human">Legacy Track: Human ICU Telemetry</option>
                <option value="aquaculture">AgTech Track: Symbiotic Biome Aquaculture</option>
                <option value="bio_logistics">Logistics Track: Cold Chain Biological Freight</option>
                <option value="datacenter_symbiosis">CleanTech Track: Industrial Data Center Greenhouse</option>
            </select>
        </div>
    </header>

    <div class="grid">
        <div class="panel">
            <div class="panel-header" id="monitor-title">Telemetry Stream Engine Monitor</div>
            <div class="vitals-grid" id="vitals-container"></div>
            <button style="background:#475569;" onclick="stepFrame()">Advance Baseline Single Step (1 Min)</button>
        </div>

        <div class="panel">
            <div class="panel-header">Matrix Manipulation Matrix ("Poke")</div>
            <div class="control-group">
                <label>Target Variable Factor</label>
                <select id="poke-target"></select>
            </div>
            <div class="control-group">
                <label>Injection Scalar Override Value</label>
                <input type="number" id="poke-value" step="any">
            </div>
            <button style="background:var(--accent-red); margin-bottom:20px;" onclick="poke()">Execute Vector Poke Override</button>

            <div class="panel-header">Time-Scrubbing Calculations Engine</div>
            <div class="control-group">
                <label>Fast-Forward Projection Bounds (Minutes)</label>
                <input type="number" id="ff-val" value="15">
                <button style="background:var(--accent-green); margin-top:8px;" onclick="fastForward()">Run Forward Projection Matrix</button>
            </div>
            <div class="control-group" style="margin-top:20px;">
                <label>Rewind Buffer History Frames</label>
                <input type="number" id="rw-val" value="5">
                <button style="background:#4b5563; margin-top:8px;" onclick="rewind()">Restore CCH Historical Frame</button>
            </div>
        </div>
    </div>

    <div class="footer-bar">
        <span style="color:var(--accent-blue); font-weight:bold;">ENGINE HEAD:</span>
        <div id="step-lbl" style="background:#000; padding:5px 12px; border-radius:4px;">STEP: 0000</div>
        <div id="log" style="color:#94a3b8; font-size:13px;">System online. Operational matrix listening.</div>
    </div>
</div>

<script>
    const API = "http://localhost:8000";
    let activeMetrics = {};

    async function switchSector() {
        const sector = document.getElementById('sector-selector').value;
        const res = await fetch(`${API}/initialize-sector`, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ sector_id: sector })
        });
        document.getElementById('log').innerText = `Switched sector loop context workspace target to: ${sector}`;
        getTelemetry();
    }

    async function getTelemetry() {
        const res = await fetch(`${API}/telemetry`);
        const data = await res.json();
        activeMetrics = data.metrics;
        
        document.getElementById('step-lbl').innerText = `STEP: ${data.current_step}`;
        document.getElementById('monitor-title').innerText = `Active Telemetry Stream: [${data.sector.toUpperCase()}]`;
        
        const container = document.getElementById('vitals-container');
        const selector = document.getElementById('poke-target');
        
        const currentTarget = selector.value;
        container.innerHTML = '';
        selector.innerHTML = '';
        
        for (let key in activeMetrics) {
            container.innerHTML += `<div class="card"><div class="card-lbl">${key.replace(/_/g,' ')}</div><div class="card-val">${activeMetrics[key]}</div></div>`;
            selector.innerHTML += `<option value="${key}">${key}</option>`;
        }
        if(currentTarget && activeMetrics[currentTarget] !== undefined) selector.value = currentTarget;
    }

    async function stepFrame() {
        await fetch(`${API}/step`, {method: 'POST'});
        getTelemetry();
    }

    async function poke() {
        const vName = document.getElementById('poke-target').value;
        const val = parseFloat(document.getElementById('poke-value').value);
        await fetch(`${API}/poke`, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ variable_name: vName, value: val })
        });
        getTelemetry();
    }

    async function fastForward() {
        const mins = parseFloat(document.getElementById('ff-val').value);
        await fetch(`${API}/fast-forward`, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ minutes: mins })
        });
        getTelemetry();
    }

    async function rewind() {
        const steps = parseInt(document.getElementById('rw-val').value);
        await fetch(`${API}/rewind`, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ steps: steps })
        });
        getTelemetry();
    }

    window.onload = getTelemetry;
</script>
</body>
</html>
